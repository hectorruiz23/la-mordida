# Persistence lives outside the binary: one SQLite file and one content-addressed
# object tree. Both directories are created by deploy/install.sh.
CONTRATOS_DB=/var/lib/la-mordida/contratos.db
CONTRATOS_OBJECTS=/var/lib/la-mordida/objects
CONTRATOS_ADDR=127.0.0.1:8770
CONTRATOS_BACKUP=/var/backups/la-mordida
